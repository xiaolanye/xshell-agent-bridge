{
  "allow": [
    "sh -c 'pgrep -f app | head -1'",
    "X=$(hostname -I)",
    "X=$(ss -lntp)",
    "git clean -fdn",
    "git clean --dry-run -fd"
  ],
  "review": [
    "sh -c 'team_status_probe'",
    "sh -c 'pwd' extra",
